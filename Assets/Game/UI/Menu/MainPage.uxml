<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Theme/Common.uss" />
    <ui:Style src="PauseMenu.uss" />
    <ui:VisualElement class="page__content">
        <ui:Label name="connectionLabel" class="status" text="○ Подключение к серверу…" />
        <ui:Label name="lobbyCountLabel" class="section-title" text="В лобби: 0" />
        <ui:ScrollView name="playerList" class="player-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
        <ui:Label name="playerListHint" class="hint" text="Список появится после подключения" />
        <ui:VisualElement class="spacer" />
        <ui:Button name="resumeButton" class="menu-button" text="Продолжить" />
        <ui:Button name="respawnButton" class="menu-button" text="Вернуться на старт (если провалились или застряли)" />
        <ui:Button name="settingsButton" class="menu-button" text="Настройки" />
        <ui:Button name="quitButton" class="menu-button" text="Выход" />
        <ui:VisualElement name="quitConfirm" class="row hidden">
            <ui:Label class="row__field" text="Выйти из приложения?" />
            <ui:Button name="quitConfirmButton" class="menu-button menu-button--danger" text="Да, выйти" />
            <ui:Button name="quitCancelButton" class="menu-button" text="Отмена" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
